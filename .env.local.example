# ローカル開発: 次のいずれかを .env.local にコピーして値を埋めてください。
#   cp env/development.env.example .env.local
#   （Windows PowerShell: Copy-Item env/development.env.example .env.local）
# またはこのファイルをそのまま .env.local にコピーしても構いません。
#
# プレビュー / 本番のキーはリポジトリに入れず、Vercel の各 Environment に登録します（env/preview.env.example / env/production.env.example を参照）。
#
# Supabase の値は Dashboard → Project Settings → API から取得します（環境ごとにプロジェクトが違えばキーも別）。

# === Supabase（一般） ===
# 公開 URL / anon はクライアント・サーバー共通。プレースホルダー（xxxxxxxx 等）のままでは接続されません。
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# === Supabase Service Role（サーバーのみ・秘密） ===
# Dashboard → Project Settings → API →「service_role」の Secret（anon とは別キー）。
# 管理者ユーザー一覧（auth.admin.listUsers）、監査ログ、Stripe 連携 API 等に必須。クライアント・リポジトリ・フロントに絶対に含めないこと。
SUPABASE_SERVICE_ROLE_KEY=

# 本番・Preview の正規 URL（OAuth 戻り先のベース。未設定時はブラウザの origin）
# 例: https://splitrip-zeta.vercel.app またはカスタムドメイン
NEXT_PUBLIC_SITE_URL=

# Supabase CLI で `supabase link` / `db push` するときのみ（Project Settings → Database のパスワード。アプリ実行には不要）
# SUPABASE_DB_PASSWORD=

# LINE ログイン（LINE Developers のチャネル ID / シークレット）
# コールバック URL には次の値と完全一致する URL を LINE コンソールに登録してください（例: https://あなたのドメイン/api/auth/callback/line）
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
NEXT_PUBLIC_LINE_REDIRECT_URI=

# Stripe（PRO課金）
# Checkout / Payment Link（クライアント公開）
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=

# Stripe Webhook（サーバー専用）
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# 設定画面の「支払い管理」ボタン遷移先（Stripe Customer Portal URL）
STRIPE_CUSTOMER_PORTAL_URL=

# Gemini OCR（サーバー専用）
GEMINI_API_KEY=
# 既定値: gemini-2.0-flash（必要に応じて利用可能モデルへ変更）
GEMINI_MODEL=gemini-2.0-flash
