# リポジトリ用の変数一覧（プレースホルダーのみ）。実際の値は各環境で設定する。
# ローカル: env/development.env.example → .env.local
# Vercel: env/preview.env.example / env/production.env.example を参照

NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
NEXT_PUBLIC_LINE_REDIRECT_URI=

NEXT_PUBLIC_STRIPE_PAYMENT_LINK=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CUSTOMER_PORTAL_URL=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# WebAuthn（本番のパスキー用 RP ID。未設定時はホスト名から決定。推奨: splitrip.net）
WEBAUTHN_RP_ID=

# 管理 API の Step-Up（WebAuthn 再認証）。true のときのみ要求。未設定はオフ。
ADMIN_STEP_UP_ENABLED=
