{
  "description": "Pencil variables と globals.css / apple-design.ts の対応。design/*.pen の variables と同期すること。",
  "variables": {
    "color.apple.bg": { "type": "color", "css": "--apple-bg", "light": "#ffffff", "dark": "#000000" },
    "color.apple.surface": { "type": "color", "css": "--apple-surface", "light": "#fbfbfd", "dark": "#2c2c2e" },
    "color.apple.text": { "type": "color", "css": "--apple-text", "light": "#1d1d1f", "dark": "#f5f5f7" },
    "color.apple.textSecondary": {
      "type": "color",
      "css": "--apple-text-secondary",
      "light": "#6e6e73",
      "dark": "#86868b"
    },
    "color.apple.link": { "type": "color", "css": "--apple-link", "light": "#0066cc", "dark": "#2997ff" },
    "color.apple.separator": {
      "type": "color",
      "css": "--apple-separator",
      "light": "rgba(0, 0, 0, 0.08)",
      "dark": "rgba(255, 255, 255, 0.12)"
    },
    "color.apple.cardBg": { "type": "color", "css": "--apple-card-bg", "light": "#ffffff", "dark": "#1d1d1f" },
    "color.apple.navBg": {
      "type": "color",
      "css": "--apple-nav-bg",
      "light": "rgba(251, 251, 253, 0.8)",
      "dark": "rgba(29, 29, 31, 0.8)"
    },
    "color.apple.lp.bg": { "type": "color", "css": "--apple-lp-bg", "value": "#000000" },
    "color.apple.lp.text": { "type": "color", "css": "--apple-lp-text", "value": "#f5f5f7" },
    "color.apple.lp.link": { "type": "color", "css": "--apple-lp-link", "value": "#2997ff" },
    "spacing.gridUnit": { "type": "number", "value": 8 },
    "radius.insetGroup": { "type": "number", "value": 16 },
    "radius.sheet": { "type": "number", "value": 28 },
    "radius.pill": { "type": "number", "value": 9999 },
    "size.touchMin": { "type": "number", "value": 44 },
    "size.listRowMin": { "type": "number", "value": 52 },
    "size.header": { "type": "number", "value": 48 },
    "size.tabBar": { "type": "number", "value": 56 },
    "size.contentMaxWidth": { "type": "number", "value": 980 },
    "typography.body": { "type": "number", "value": 17 },
    "typography.caption": { "type": "number", "value": 12 },
    "typography.tabLabel": { "type": "number", "value": 11 },
    "typography.largeTitle": { "type": "number", "value": 34 }
  }
}
