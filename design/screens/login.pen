{
  "version": "2.10",
  "variables": {
    "color.apple.bg": {
      "type": "color",
      "value": "#ffffff"
    },
    "color.apple.surface": {
      "type": "color",
      "value": "#fbfbfd"
    },
    "color.apple.text": {
      "type": "color",
      "value": "#1d1d1f"
    },
    "color.apple.textSecondary": {
      "type": "color",
      "value": "#6e6e73"
    },
    "color.apple.link": {
      "type": "color",
      "value": "#0066cc"
    },
    "color.apple.separator": {
      "type": "color",
      "value": "rgba(0, 0, 0, 0.08)"
    },
    "color.apple.cardBg": {
      "type": "color",
      "value": "#ffffff"
    },
    "color.apple.navBg": {
      "type": "color",
      "value": "rgba(251, 251, 253, 0.8)"
    },
    "color.apple.lp.bg": {
      "type": "color",
      "value": "#000000"
    },
    "color.apple.lp.text": {
      "type": "color",
      "value": "#f5f5f7"
    },
    "color.apple.lp.link": {
      "type": "color",
      "value": "#2997ff"
    },
    "spacing.gridUnit": {
      "type": "number",
      "value": 8
    },
    "radius.insetGroup": {
      "type": "number",
      "value": 16
    },
    "radius.sheet": {
      "type": "number",
      "value": 28
    },
    "radius.pill": {
      "type": "number",
      "value": 9999
    },
    "size.touchMin": {
      "type": "number",
      "value": 44
    },
    "size.listRowMin": {
      "type": "number",
      "value": 52
    },
    "size.header": {
      "type": "number",
      "value": 48
    },
    "size.tabBar": {
      "type": "number",
      "value": 56
    },
    "size.contentMaxWidth": {
      "type": "number",
      "value": 980
    },
    "typography.body": {
      "type": "number",
      "value": 17
    },
    "typography.caption": {
      "type": "number",
      "value": 12
    },
    "typography.tabLabel": {
      "type": "number",
      "value": 11
    },
    "typography.largeTitle": {
      "type": "number",
      "value": 34
    },
    "color.dark.bg": {
      "type": "color",
      "value": "#000000"
    },
    "color.dark.surface": {
      "type": "color",
      "value": "#2c2c2e"
    },
    "color.dark.text": {
      "type": "color",
      "value": "#f5f5f7"
    },
    "color.dark.textSecondary": {
      "type": "color",
      "value": "#86868b"
    },
    "color.dark.link": {
      "type": "color",
      "value": "#2997ff"
    },
    "color.dark.separator": {
      "type": "color",
      "value": "rgba(255, 255, 255, 0.12)"
    },
    "color.dark.cardBg": {
      "type": "color",
      "value": "#1d1d1f"
    },
    "color.dark.navBg": {
      "type": "color",
      "value": "rgba(29, 29, 31, 0.8)"
    }
  },
  "children": [
    {
      "id": "login-mobile",
      "name": "Login / Mobile",
      "type": "frame",
      "x": 0,
      "y": 0,
      "width": 375,
      "height": 812,
      "fill": "$color.apple.bg",
      "layout": "vertical",
      "justifyContent": "center",
      "padding": [
        0,
        24
      ],
      "gap": 24,
      "children": [
        {
          "id": "login-mobile-logo",
          "type": "text",
          "content": "SpliTrip",
          "fontSize": 40,
          "fontWeight": "700",
          "fill": "$color.apple.text"
        },
        {
          "id": "login-mobile-desc",
          "type": "text",
          "content": "かんたん割り勘アプリ",
          "fontSize": 17,
          "fill": "$color.apple.textSecondary"
        },
        {
          "id": "login-mobile-email-field",
          "type": "frame",
          "width": "fill_container",
          "height": 44,
          "cornerRadius": 12,
          "fill": "$color.apple.surface",
          "stroke": {
            "thickness": 1,
            "fill": "$color.apple.separator"
          },
          "padding": [
            0,
            12
          ],
          "alignItems": "center",
          "children": [
            {
              "id": "login-mobile-email-placeholder",
              "type": "text",
              "content": "メールアドレス",
              "fontSize": 15,
              "fill": "$color.apple.textSecondary"
            }
          ]
        },
        {
          "id": "login-mobile-submit",
          "type": "frame",
          "width": "fill_container",
          "height": 44,
          "cornerRadius": "$radius.pill",
          "fill": "$color.apple.link",
          "layout": "horizontal",
          "justifyContent": "center",
          "alignItems": "center",
          "children": [
            {
              "id": "login-mobile-submit-label",
              "type": "text",
              "content": "ログイン",
              "fill": "#ffffff",
              "fontWeight": "500"
            }
          ]
        }
      ]
    },
    {
      "id": "login-desktop",
      "name": "Login / Desktop",
      "type": "frame",
      "x": 420,
      "y": 0,
      "width": 1280,
      "height": 900,
      "fill": "$color.apple.bg",
      "layout": "vertical",
      "justifyContent": "center",
      "alignItems": "center",
      "children": [
        {
          "id": "login-desktop-card",
          "type": "frame",
          "width": 400,
          "cornerRadius": "$radius.sheet",
          "fill": "$color.apple.cardBg",
          "stroke": {
            "thickness": 1,
            "fill": "$color.apple.separator"
          },
          "layout": "vertical",
          "padding": 32,
          "gap": 20,
          "children": [
            {
              "id": "login-desktop-logo",
              "type": "text",
              "content": "SpliTrip",
              "fontSize": 32,
              "fontWeight": "700",
              "fill": "$color.apple.text"
            },
            {
              "id": "login-desktop-desc",
              "type": "text",
              "content": "かんたん割り勘アプリ",
              "fontSize": 15,
              "fill": "$color.apple.textSecondary"
            }
          ]
        }
      ]
    }
  ]
}
