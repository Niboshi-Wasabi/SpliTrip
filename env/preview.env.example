# Vercel Preview（PR デプロイ）用テンプレート
# Vercel: Project → Settings → Environment Variables → Environment: Preview で登録
# 中身は「プレビュー用」Supabase プロジェクト（本番と分けるなら別プロジェクト）の API キーに合わせる

NEXT_PUBLIC_SITE_URL=https://your-app-git-branch-name.vercel.app

NEXT_PUBLIC_SUPABASE_URL=https://yyyyyyyy.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
NEXT_PUBLIC_LINE_REDIRECT_URI=

NEXT_PUBLIC_STRIPE_PAYMENT_LINK=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CUSTOMER_PORTAL_URL=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
