# ローカル開発用テンプレート
# 使い方: リポジトリルートで次を実行し、値を貼る
#   cp env/development.env.example .env.local
#
# Supabase を「PC 上だけ」にしたい場合（本番 DB と分離）:
#   npm run db:local:start
#   npm run db:local:status  で表示される URL / anon / service_role を下にコピー（例: API http://127.0.0.1:54321）
# クラウドの「開発用プロジェクト」を使う場合は、Dashboard → API の値を貼る。
#
# 各キーはその Supabase プロジェクト専用（本番・プレビューとは別プロジェクトなら別々の値）。

# === Supabase（一般） ===
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# === Supabase Service Role（サーバーのみ・秘密） ===
SUPABASE_SERVICE_ROLE_KEY=

# ローカルでは通常は http://localhost:3000（OAuth リダイレクトのベース）
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase CLI で `supabase link` / `db push` するときのみ
# SUPABASE_DB_PASSWORD=

# LINE ログイン
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
NEXT_PUBLIC_LINE_REDIRECT_URI=

# Stripe
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CUSTOMER_PORTAL_URL=

# Gemini OCR
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# WebAuthn RP ID（任意。未設定時はホスト名を自動使用。本番は splitrip.net 推奨）
WEBAUTHN_RP_ID=
